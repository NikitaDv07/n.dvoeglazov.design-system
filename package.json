{
  "name": "hired-wired-ds",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "vite",
    "build": "pnpm tokens && tsc -b && vite build",
    "preview": "vite preview",
    "fonts": "tsx scripts/build-fonts.ts",
    "tokens:normalize": "tsx scripts/normalize-tokens.ts",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "tokens": "pnpm tokens:normalize && pnpm tokens:build",
    "verify": "tsx scripts/verify-tokens.ts",
    "verify:visual": "playwright test",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings",
    "check:styles": "tsx scripts/check-styles.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.14.0",
    "jsdom": "30.1.2",
    "oxlint": "1.87.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wawoff2": "2.0.1"
  }
}
